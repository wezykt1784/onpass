# Copy to .env.local and fill in. Leave the two Supabase values empty to run on demo data.
# Supabase dashboard > Project Settings > API. Both are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC. Used only to invite people from Admin > People.
SUPABASE_SERVICE_ROLE_KEY=
# The address the app runs at, e.g. https://spec.portobellopubs.co.uk. Used in invite emails and QR codes.
NEXT_PUBLIC_SITE_URL=
# Set to true only when this Supabase project is used by Onpass alone. Then deleting a person in
# Admin > People also deletes their login. Leave empty if other apps share the same logins.
ONPASS_OWNS_AUTH=
