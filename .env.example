# Copy to .env.local and fill in. Leave both NEXT_PUBLIC_ values empty to run on demo data.
# Supabase dashboard > Project Settings > API. Both are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC. Needed later for inviting users (milestone 2a). Not used yet.
SUPABASE_SERVICE_ROLE_KEY=
